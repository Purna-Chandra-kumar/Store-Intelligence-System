# --- Postgres ---
POSTGRES_USER=store
POSTGRES_PASSWORD=storepass
POSTGRES_DB=store_intel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (event bus) ---
REDIS_HOST=redis
REDIS_PORT=6379
EVENT_STREAM=store.events
CONSUMER_GROUP=backend-consumers

# --- AI engine ---
VIDEO_SOURCE=/data/sample.mp4
CAMERA_ID=cam-01
TARGET_FPS=8
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
DEVICE=cpu

# --- Backend ---
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events
